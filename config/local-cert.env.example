# Local offline certification only. Copy to config/local-cert.env.
NODE_ENV=development
APP_ENV=development
TARGET_ENV=local
EXPECTED_ENVIRONMENT=local
DATABASE_URL=postgresql://apex_offline_cert:<LOCAL_RANDOM_PASSWORD>@127.0.0.1:54320/apexos_offline_cert_local
DIRECT_URL=postgresql://apex_offline_cert:<LOCAL_RANDOM_PASSWORD>@127.0.0.1:54320/apexos_offline_cert_local
DISABLE_REDIS=true
REDIS_DISABLED=true
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

