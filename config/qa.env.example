# Plantilla QA. Copiar a config/qa.env y completar mediante el gestor de secretos.
# Nunca confirmar valores reales.
NODE_ENV=production
APP_ENV=qa
TARGET_ENV=qa
EXPECTED_ENVIRONMENT=qa
EXPECTED_SUPABASE_PROJECT_REF=<QA_PROJECT_REF>

FRONTEND_URL=<QA_FRONTEND_URL>
NEXT_PUBLIC_API_URL=<QA_API_URL>
NEXT_PUBLIC_OFFLINE_DISCOVERY_ENABLED=false
DATABASE_URL=<QA_DATABASE_URL>
DIRECT_URL=<QA_DIRECT_URL>
SUPABASE_URL=https://<QA_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<QA_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<QA_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<QA_SERVICE_ROLE_KEY>
JWT_SECRET=<QA_JWT_SECRET>

AUTHORIZED_EVIDENCE_UPLOADS_ENABLED=false
NEXT_PUBLIC_AUTHORIZED_EVIDENCE_UPLOADS_ENABLED=false
AUTHORIZATION_VERSION_OBSERVATION_ENABLED=true
AUTHORIZATION_VERSION_ENFORCEMENT_ENABLED=false

# Enable only after confirming one or two active Tecnico users assigned to Nyvora.
OFFLINE_TECHNICIAN_ENABLED=false
OFFLINE_SYNC_ENABLED=false
OFFLINE_EVIDENCE_UPLOAD_ENABLED=false
OFFLINE_AUTO_SYNC_ENABLED=false
OFFLINE_ALLOWED_ENVIRONMENTS=
OFFLINE_ALLOWED_TENANT_IDS=
OFFLINE_ALLOWED_USER_IDS=
OFFLINE_ALLOWED_ROLES=
OFFLINE_BOOTSTRAP_TTL_SECONDS=86400
OFFLINE_BOOTSTRAP_FUTURE_DAYS=7
OFFLINE_BOOTSTRAP_MAX_ORDERS=100
OFFLINE_BOOTSTRAP_MAX_ACTIVITIES=500
OFFLINE_BOOTSTRAP_MAX_CHECKLISTS=1000
OFFLINE_BOOTSTRAP_MAX_CATALOGS=100
OFFLINE_BOOTSTRAP_MAX_BYTES=1048576
OFFLINE_BOOTSTRAP_TIMEOUT_MS=5000
