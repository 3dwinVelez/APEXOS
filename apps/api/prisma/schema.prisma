}

model EvidenceUploadAuthorization {
  id                    String   @id @default(uuid())
  tenant_id             String
  company_id            String?
  order_key             String
  user_id               Int
  supabase_user_id      String?
  purpose               String
  expected_mime_type    String
  expected_size_bytes   Int
  client_upload_id      String
  quarantine_path       String   @unique
  final_path            String?
  status                String   @default("authorized")
  rejection_reason      String?
  detected_mime_type    String?
  detected_size_bytes   Int?
  detected_width        Int?
  detected_height       Int?
  checksum_sha256       String?
  expires_at            DateTime
  confirmed_at          DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id, client_upload_id])
  @@index([tenant_id, order_key, status])
  @@index([status, expires_at])
  @@map("evidence_upload_authorizations")
}

model Payroll {
  id            Int      @id @default(autoincrement())
  tenant_id     String
  employee_id   Int
  employee      Employee @relation(fields: [employee_id], references: [id])
  period        String
  days_worked   Float
  overtime_hrs  Float    @default(0)
  absences      Float    @default(0)
  gross         Float
  deductions    Float
  net           Float
  employer_cost Float    @default(0)
  detail        Json
  status        String   @default("draft")
  paid_at       DateTime?
  created_at    DateTime @default(now())

  @@unique([employee_id, period])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
}

// === FACTURA DE VENTA ===
model SalesInvoice {
  id                Int                @id @default(autoincrement())
  tenant_id         String
  number            String
  customer_id       Int
  customer          Party              @relation(fields: [customer_id], references: [id])
  place_id          Int?
  place             Place?             @relation(fields: [place_id], references: [id])
  date              DateTime           @default(now())
  due_date          DateTime
  due_term          String             @default("AP30")
  subtotal          Float              @default(0)
  tax_total         Float              @default(0)
  discount_total    Float              @default(0)
  retention_total   Float              @default(0)
  total             Float              @default(0)
  balance           Float              @default(0)
  status            String             @default("draft")
  header_text       String             @default("")
  society_code      String             @default("")
  branch_code       String             @default("")
  cost_center_code  String             @default("")
  notes             String?
  created_by        Int?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  lines             SalesInvoiceLine[]
  cxc               CxcCabdoc?

  @@map("sales_invoices")
  @@unique([tenant_id, number])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, date])
  @@index([tenant_id, status])
}

model SalesInvoiceLine {
  id                      Int          @id @default(autoincrement())
  tenant_id               String
  invoice_id              Int
  invoice                 SalesInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  line_no                 Int
  item_id                 Int?
  item                    Item?        @relation(fields: [item_id], references: [id])
  description             String
  qty                     Float
  unit                    String       @default("UND")
  unit_price              Float
  discount                Float        @default(0)
  subtotal                Float
  tax_rate                Float        @default(0)
  tax_amount              Float        @default(0)
  total                   Float
  place_id                Int?
  place                   Place?       @relation(fields: [place_id], references: [id])
  customer_invoice_number String?
  cost_value              Float        @default(0)
  created_at              DateTime     @default(now())

  @@map("sales_invoice_lines")
  @@index([tenant_id, invoice_id])
  @@index([tenant_id, item_id])
}

// === CUENTAS POR COBRAR ===
model CxcCabdoc {
  id                      Int         @id @default(autoincrement())
  tenant_id               String
  document_kind           String
  document_class          String
  number                  String
  customer_reference      String      @default("")
  posting_date            DateTime
  due_term                String
  due_date                DateTime
  header_text             String
  customer_id             Int
  customer_tax_id         String?
  society_code            String
  associated_account_id   Int
  associated_account_code String
  sales_invoice_id        Int? @unique
  salesInvoice            SalesInvoice? @relation(fields: [sales_invoice_id], references: [id])
  subtotal                Float       @default(0)
  tax_total               Float       @default(0)
  total                   Float       @default(0)
  retention_total         Float       @default(0)
  applied_total           Float       @default(0)
  balance                 Float       @default(0)
  status                  String      @default("open")
  accounting_document_id  Int?
  created_by              Int?
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt
  lines                   CxcCuedoc[]
  payments                CxcPayment[]

  @@map("cxc_cabdoc")
  @@unique([tenant_id, number])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, customer_id, balance])
  @@index([tenant_id, posting_date])
  @@index([tenant_id, due_date])
  @@index([tenant_id, document_class])
}

model CxcCuedoc {
  id                Int       @id @default(autoincrement())
  tenant_id         String
  cabdoc_id         Int
  cabdoc            CxcCabdoc @relation(fields: [cabdoc_id], references: [id], onDelete: Cascade)
  line_no           Int
  account_id        Int
  account_code      String
  branch_code       String
  cost_center_code  String
  movement          String
  description       String
  amount            Float     @default(0)
  total             Float     @default(0)
  retention_code    String?
  retention_percent Float     @default(0)
  retention_amount  Float     @default(0)
  created_at        DateTime  @default(now())

  @@map("cxc_cuedoc")
  @@index([tenant_id, cabdoc_id])
  @@index([tenant_id, account_code])
}

model CxcPayment {
  id            Int       @id @default(autoincrement())
  tenant_id     String
  cabdoc_id     Int?
  cabdoc        CxcCabdoc? @relation(fields: [cabdoc_id], references: [id])
  customer_id   Int?
  type          String
  method        String
  amount        Float
  date          DateTime  @default(now())
  reference     String?
  account_id    Int?
  notes         String?
  created_by    Int?
  created_at    DateTime  @default(now())

  @@map("cxc_payments")
  @@index([tenant_id, cabdoc_id])
  @@index([tenant_id, customer_id, date])
}

// === MAESTRO DE RETENCIONES ===
model RetentionMaster {
  id           Int      @id @default(autoincrement())
  tenant_id    String
  code         String
  description  String
  account_code String
  percent      Float
  concept      String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("retention_masters")
  @@unique([tenant_id, code])
  @@index([tenant_id, active])
}

model OKR {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  employee_id Int
  employee    Employee @relation(fields: [employee_id], references: [id])
  objective   String
  key_results Json
  period      String
  score       Float    @default(0)
  status      String   @default("active")

  @@index([tenant_id, period])
}

model Payment {
  id             Int          @id @default(autoincrement())
  tenant_id      String
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id])
  party_id       Int?
  type           String
  method         String
  amount         Float
  date           DateTime     @default(now())
  reference      String?
  account_id     Int?
  notes          String?
  created_by     Int?
  created_at     DateTime     @default(now())

  @@index([tenant_id, type, date])
}

model Subscription {
  id             Int                   @id @default(autoincrement())
  tenant_id      String                @unique
  tenant         Tenant                @relation(fields: [tenant_id], references: [id])
  plan           String
  status         String                @default("active")
  price_monthly  Float
  billing_day    Int                   @default(1)
  trial_ends     DateTime?
  next_billing   DateTime?
  payment_method Json?
  created_at     DateTime              @default(now())
  invoices       SubscriptionInvoice[]
}

model SubscriptionInvoice {
  id              Int          @id @default(autoincrement())
  subscription_id Int
  subscription    Subscription @relation(fields: [subscription_id], references: [id])
  period          String
  amount          Float
  status          String       @default("pending")
  paid_at         DateTime?
  created_at      DateTime     @default(now())
}

model BrainEvent {
  id         BigInt   @id @default(autoincrement())
  tenant_id  String
  type       String
  module     String
  context    Json
  suggestion Json?
  accepted   Boolean?
  feedback   String?
  created_at DateTime @default(now())

  @@index([tenant_id, module, created_at])
}

model BrainMetric {
  id         BigInt   @id @default(autoincrement())
  tenant_id  String
  metric     String
  value      Float
  period     String
  created_at DateTime @default(now())

  @@index([tenant_id, metric, period])
}

model Workflow {
  id          Int     @id @default(autoincrement())
  tenant_id   String
  name        String
  entity      String
  states      Json
  transitions Json
  active      Boolean @default(true)

  @@index([tenant_id, entity])
}

model CustomField {
  id        Int     @id @default(autoincrement())
  tenant_id String
  entity    String
  name      String
  label     String
  type      String
  options   Json?
  required  Boolean @default(false)
  active    Boolean @default(true)

  @@unique([tenant_id, entity, name])
}

model Threshold {
  id          Int      @id @default(autoincrement())
  resource_id Int
  resource    Resource @relation(fields: [resource_id], references: [id])
  sensor      String
  min_val     Float?
  max_val     Float?
  alert_type  String   @default("warning")
}

model SensorReading {
  id          BigInt   @id @default(autoincrement())
  tenant_id   String
  resource_id Int
  sensor      String
  value       Float
  unit        String?
  timestamp   DateTime @default(now())

  @@index([resource_id, sensor, timestamp])
  @@index([tenant_id])
}

model EInvoiceConfig {
  id                   Int      @id @default(autoincrement())
  tenant_id            String   @unique
  country              String
  environment          String   @default("sandbox")
  dian_software_id     String?
  dian_software_pin    String?
  dian_test_set_id     String?
  dian_resolution_num  String?
  dian_resolution_date DateTime?
  dian_prefix          String?
  dian_from_num        Int?
  dian_to_num          Int?
  dian_current_num     Int      @default(0)
  sat_rfc              String?
  sat_cert_b64         String?
  sat_key_b64          String?
  sat_cert_pass        String?
  sat_regime           String?
  sunat_ruc            String?
  sunat_user           String?
  sunat_pass           String?
  sunat_ose            String?
  cert_pkcs12_b64      String?
  cert_password        String?
  active               Boolean  @default(false)
  created_at           DateTime @default(now())
