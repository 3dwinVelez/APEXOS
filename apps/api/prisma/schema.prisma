generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String        @id @default(uuid())
  name           String
  domain         String?       @unique
  industry       String        @default("generic")
  plan           String        @default("seed")
  active_modules Json          @default("[]")
  config         Json          @default("{}")
  brain_model    String?
  timezone       String        @default("America/Bogota")
  currency       String        @default("COP")
  tax_id         String?
  country        String        @default("CO")
  active         Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  subscription   Subscription?
}

model User {
  id          Int       @id @default(autoincrement())
  tenant_id   String
  name        String
  email       String
  password    String
  role_id     Int?
  role        Role?     @relation(fields: [role_id], references: [id])
  avatar      String?
  active      Boolean   @default(true)
  last_login  DateTime?
  preferences Json      @default("{}")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  employee    Employee?
  evidence_upload_authorizations EvidenceUploadAuthorization[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
}

model Role {
  id          Int          @id @default(autoincrement())
  tenant_id   String
  name        String
  description String?
  is_system   Boolean      @default(false)
  metadata    Json         @default("{}")
  permissions Permission[]
  users       User[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

model Permission {
  id      Int    @id @default(autoincrement())
  role_id Int
  module  String
  action  String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, module, action])
}

model SoDRule {
  id            Int    @id @default(autoincrement())
  tenant_id     String
  role_a        String
  role_b        String
  conflict_type String
  description   String

  @@index([tenant_id])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenant_id  String
  user_id    Int?
  session_id String?
  action     String
  module     String
  entity     String
  entity_id  String?
  old_value  Json?
  new_value  Json?
  ip         String?
  user_agent String?
  timestamp  DateTime @default(now())

  @@index([tenant_id, module, timestamp])
  @@index([tenant_id, entity, entity_id])
}

model Party {
  id           Int           @id @default(autoincrement())
  tenant_id    String
  type         String
  name         String
  legal_name   String?
  tax_id       String?
  tax_type     String?
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String        @default("CO")
  segment      String?
  credit_limit Float         @default(0)
  credit_days  Int           @default(0)
  balance      Float         @default(0)
  rating       Float         @default(0)
  active       Boolean       @default(true)
  metadata     Json          @default("{}")
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  transactions Transaction[]
  contacts     Contact[]
  salesInvoices SalesInvoice[]

  @@index([tenant_id, type])
  @@index([tenant_id, type, active, name])
  @@index([tenant_id, tax_id])
}

model Contact {
  id       Int     @id @default(autoincrement())
  party_id Int
  name     String
  role     String?
  email    String?
  phone    String?
  primary  Boolean @default(false)
  party    Party   @relation(fields: [party_id], references: [id])
}

model Item {
  id            Int               @id @default(autoincrement())
  tenant_id     String
  type          String
  code          String
  name          String
  description   String?
  category_id   Int?
  category      Category?         @relation(fields: [category_id], references: [id])
  family_id     Int?
  family        InventoryFamily?   @relation(fields: [family_id], references: [id])
  family_code   String?
  society_code  String?
  branch_code   String?
  unit          String            @default("UND")
  unit_cost     Float             @default(0)
  costing_method String           @default("weighted_average")
  unit_price    Float             @default(0)
  tax_rate      Float             @default(0)
  stock_current Float             @default(0)
  stock_min     Float             @default(0)
  stock_max     Float?
  weight_kg     Float             @default(0)
  volume_m3     Float             @default(0)
  abc_class     String            @default("C")
  active        Boolean           @default(true)
  metadata      Json              @default("{}")
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  locations     ItemLocation[]
  bom_lines     BOMLine[]
  movements     Movement[]
  costs         ProductCost[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([tenant_id, code])
  @@index([tenant_id, type])
  @@index([tenant_id, family_code])
  @@index([tenant_id, society_code, branch_code])
  @@index([tenant_id, active])
}

model InventoryFamily {
  id          Int                        @id @default(autoincrement())
  tenant_id   String
  code        String
  name        String
  description String?
  society_code String?
  branch_code String?
  code_start  String?
  code_end    String?
  active      Boolean                    @default(true)
  created_at  DateTime                   @default(now())
  updated_at  DateTime                   @updatedAt
  items       Item[]
  accounting  InventoryFamilyAccounting?

  @@map("inv_families")
  @@unique([tenant_id, code])
  @@index([tenant_id, society_code, branch_code])
  @@index([tenant_id, active])
}

model InventoryFamilyAccounting {
  id                            Int             @id @default(autoincrement())
  tenant_id                     String
  family_id                     Int             @unique
  family                        InventoryFamily @relation(fields: [family_id], references: [id], onDelete: Cascade)
  goods_receipt_account_code    String
  gr_ir_account_code            String
  sales_cost_account_code       String
  sales_revenue_account_code    String
  return_revenue_account_code   String
  manual_in_account_code        String
  manual_out_account_code       String
  active                        Boolean         @default(true)
  created_at                    DateTime        @default(now())
  updated_at                    DateTime        @updatedAt

  @@map("inv_family_accounting")
  @@index([tenant_id])
}

model ProductCost {
  id               Int      @id @default(autoincrement())
  tenant_id        String
  item_id          Int
  item             Item     @relation(fields: [item_id], references: [id])
  costing_method   String   @default("weighted_average")
  quantity_balance Float    @default(0)
  value_balance    Float    @default(0)
  average_cost     Float    @default(0)
  last_unit_cost    Float    @default(0)
  source_type      String?
  source_id        Int?
  created_by       Int?
  created_at       DateTime @default(now())

  @@map("inv_product_costs")
  @@index([tenant_id, item_id, created_at])
  @@index([tenant_id, source_type, source_id])
}

model Category {
  id        Int    @id @default(autoincrement())
  tenant_id String
  name      String
  parent_id Int?
  type      String @default("item")
  items     Item[]

  @@unique([tenant_id, name, type])
  @@index([tenant_id])
}

model Place {
  id               Int        @id @default(autoincrement())
  tenant_id        String
  type             String
  name             String
  code             String
  address          String?
  city             String?
  country          String     @default("CO")
  society_code     String?
  branch_code      String?
  cost_center_code String?
  warehouse_type   String     @default("owned")
  parent_id        Int?
  active           Boolean    @default(true)
  metadata         Json       @default("{}")
  locations        Location[]
  salesInvoices SalesInvoice[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([tenant_id, code])
  @@index([tenant_id, type])
  @@index([tenant_id, society_code, branch_code, cost_center_code])
}

model Location {
  id          Int            @id @default(autoincrement())
  tenant_id   String
  place_id    Int
  place       Place          @relation(fields: [place_id], references: [id])
  code        String
  aisle       String?
  rack        String?
  level       String?
  bin         String?
  zone        String         @default("general")
  abc_class   String         @default("C")
  capacity_kg Float          @default(0)
  active      Boolean        @default(true)
  items       ItemLocation[]

  @@unique([tenant_id, place_id, code])
  @@index([tenant_id])
}

model ItemLocation {
  id          Int       @id @default(autoincrement())
  tenant_id   String
  item_id     Int
  location_id Int
  qty         Float     @default(0)
  lot         String?
  serial      String?
  expiry      DateTime?
  cost        Float?
  item        Item      @relation(fields: [item_id], references: [id])
  location    Location  @relation(fields: [location_id], references: [id])

  @@unique([item_id, location_id, lot])
  @@index([tenant_id])
}

model Transaction {
  id            Int               @id @default(autoincrement())
  tenant_id     String
  type          String
  number        String
  party_id      Int?
  party         Party?            @relation(fields: [party_id], references: [id])
  place_id      Int?
  status        String            @default("draft")
  date          DateTime          @default(now())
  due_date      DateTime?
  subtotal      Float             @default(0)
  tax_total     Float             @default(0)
  discount      Float             @default(0)
  total         Float             @default(0)
  paid          Float             @default(0)
  balance       Float             @default(0)
  currency      String            @default("COP")
  exchange_rate Float             @default(1)
  notes         String?
  metadata      Json              @default("{}")
  created_by    Int?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  lines         TransactionLine[]
  movements     Movement[]
  payments      Payment[]
  documents     Document[]
  e_invoice     EInvoice?

  @@unique([tenant_id, type, number])
  @@index([tenant_id, type, status])
  @@index([tenant_id, party_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, type, created_at])
}

model TransactionLine {
  id             Int         @id @default(autoincrement())
  transaction_id Int
  item_id        Int?
  description    String
  qty            Float
  unit           String      @default("UND")
  unit_cost      Float       @default(0)
  unit_price     Float
  discount       Float       @default(0)
  tax_rate       Float       @default(0)
  tax_amount     Float       @default(0)
  subtotal       Float
  total          Float
  metadata       Json        @default("{}")
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
}

model Movement {
  id             Int          @id @default(autoincrement())
  tenant_id      String
  type           String
  item_id        Int?
  item           Item?        @relation(fields: [item_id], references: [id])
  from_location  Int?
  to_location    Int?
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id])
  qty            Float
  cost           Float        @default(0)
  lot            String?
  reason         String?
  created_by     Int?
  created_at     DateTime     @default(now())

  @@index([tenant_id, item_id, created_at])
  @@index([tenant_id, type, created_at])
}

model Resource {
  id          Int         @id @default(autoincrement())
  tenant_id   String
  type        String
  name        String
  code        String
  place_id    Int?
  capacity    Float       @default(1)
  unit        String      @default("UND")
  cost_per_hr Float       @default(0)
  active      Boolean     @default(true)
  metadata    Json        @default("{}")
  events      Event[]
  thresholds  Threshold[]

  @@unique([tenant_id, code])
  @@index([tenant_id, type])
}

model Document {
  id             Int          @id @default(autoincrement())
  tenant_id      String
  type           String
  name           String
  file_url       String?
  file_size      Int?
  mime_type      String?
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id])
  party_id       Int?
  metadata       Json         @default("{}")
  created_by     Int?
  created_at     DateTime     @default(now())

  @@index([tenant_id, type])
  @@index([tenant_id, created_at])
}

model Event {
  id          Int       @id @default(autoincrement())
  tenant_id   String
  type        String
  title       String
  description String?
  resource_id Int?
  resource    Resource? @relation(fields: [resource_id], references: [id])
  party_id    Int?
  start_at    DateTime
  end_at      DateTime?
  all_day     Boolean   @default(false)
  status      String    @default("scheduled")
  priority    String    @default("normal")
  assigned_to Int?
  metadata    Json      @default("{}")
  created_at  DateTime  @default(now())

  @@index([tenant_id, type, start_at])
  @@index([tenant_id, status])
}

model BOM {
  id           Int       @id @default(autoincrement())
  tenant_id    String
  item_id      Int
  version      String
  status       String    @default("draft")
  yield_pct    Float     @default(100)
  notes        String?
  created_by   Int
  approved_by  Int?
  effective_dt DateTime?
  created_at   DateTime  @default(now())
  lines        BOMLine[]

  @@index([tenant_id, item_id])
}

model BOMLine {
  id        Int     @id @default(autoincrement())
  bom_id    Int
  bom       BOM     @relation(fields: [bom_id], references: [id], onDelete: Cascade)
  item_id   Int
  item      Item    @relation(fields: [item_id], references: [id])
  qty       Float
  unit      String
  scrap_pct Float   @default(0)
  step      Int?
  notes     String?
}

model WorkOrder {
  id           Int       @id @default(autoincrement())
  tenant_id    String
  number       String
  item_id      Int
  bom_id       Int?
  place_id     Int?
  qty_planned  Float
  qty_produced Float     @default(0)
  qty_rejected Float     @default(0)
  status       String    @default("planned")
  priority     String    @default("normal")
  start_at     DateTime?
  end_at       DateTime?
  cost_actual  Float     @default(0)
  metadata     Json      @default("{}")
  created_at   DateTime  @default(now())

  @@unique([tenant_id, number])
  @@index([tenant_id, status])
}

model Account {
  id        Int           @id @default(autoincrement())
  tenant_id String
  code      String
  name      String
  type      String
  parent_id Int?
  level     Int           @default(1)
  allows_tx Boolean       @default(true)
  active    Boolean       @default(true)
  entries   LedgerEntry[]

  @@unique([tenant_id, code])
  @@index([tenant_id, type])
}

model LedgerEntry {
  id             Int      @id @default(autoincrement())
  tenant_id      String
  account_id     Int
  account        Account  @relation(fields: [account_id], references: [id])
  transaction_id Int?
  date           DateTime
  debit          Float    @default(0)
  credit         Float    @default(0)
  balance        Float    @default(0)
  description    String
  period         String
  created_at     DateTime @default(now())

  @@index([tenant_id, account_id, date])
  @@index([tenant_id, period])
}

model CntCabdoc {
  id              Int         @id @default(autoincrement())
  tenant_id       String
  document_type   String
  document_number Int
  full_number     String
  posting_date    DateTime
  reference       String?
  header_text     String
  society_code    String
  status          String      @default("posted")
  total_debit     Float       @default(0)
  total_credit    Float       @default(0)
  created_by      Int?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  lines           CntCuedoc[]

  @@map("cnt_cabdoc")
  @@unique([tenant_id, document_type, document_number])
  @@unique([tenant_id, full_number])
  @@index([tenant_id, posting_date])
  @@index([tenant_id, society_code])
}

model CntCuedoc {
  id                Int       @id @default(autoincrement())
  tenant_id         String
  cabdoc_id         Int
  cabdoc            CntCabdoc @relation(fields: [cabdoc_id], references: [id], onDelete: Cascade)
  line_no           Int
  account_id        Int
  account_code      String
  branch_code       String
  cost_center_code  String
  party_id          Int
  party_tax_id      String?
  movement          String
  debit             Float     @default(0)
  credit            Float     @default(0)
  description       String
  ledger_entry_id   Int?
  created_at        DateTime  @default(now())

  @@map("cnt_cuedoc")
  @@index([tenant_id, cabdoc_id])
  @@index([tenant_id, account_code])
  @@index([tenant_id, party_id])
  @@index([tenant_id, branch_code, cost_center_code])
}

model CxpCabdoc {
  id                      Int         @id @default(autoincrement())
  tenant_id               String
  document_kind           String
  document_class          String
  number                  String
  supplier_reference      String      @default("")
  referenced_invoice_id   Int?
  posting_date            DateTime
  due_term                String
  due_date                DateTime
  header_text             String
  supplier_id             Int
  supplier_tax_id         String?
  society_code            String
  associated_account_id   Int
  associated_account_code String
  subtotal                Float       @default(0)
  tax_total               Float       @default(0)
  total                   Float       @default(0)
  applied_total           Float       @default(0)
  balance                 Float       @default(0)
  status                  String      @default("posted")
  accounting_document_id  Int?
  created_by              Int?
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt
  lines                   CxpCuedoc[]

  @@map("cxp_cabdoc")
  @@unique([tenant_id, number])
  @@index([tenant_id, document_class, supplier_id, supplier_reference])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, supplier_id, balance])
  @@index([tenant_id, referenced_invoice_id])
  @@index([tenant_id, document_class])
  @@index([tenant_id, posting_date])
  @@index([tenant_id, due_date])
  @@index([tenant_id, society_code])
  @@index([tenant_id, document_class, posting_date])
  @@index([tenant_id, supplier_id, due_date])
}

model CxpApplication {
  id             Int      @id @default(autoincrement())
  tenant_id      String
  credit_note_id Int
  invoice_id     Int
  amount         Float
  created_by     Int?
  created_at     DateTime @default(now())

  @@map("cxp_applications")
  @@index([tenant_id, credit_note_id])
  @@index([tenant_id, invoice_id])
}

model CxpCuedoc {
  id                Int       @id @default(autoincrement())
  tenant_id         String
  cabdoc_id         Int
  cabdoc            CxpCabdoc @relation(fields: [cabdoc_id], references: [id], onDelete: Cascade)
  line_no           Int
  account_id        Int
  account_code      String
  branch_code       String
  cost_center_code  String
  movement          String
  vat_code          String?
  vat_concept       String?
  vat_account_code  String?
  vat_percent       Float     @default(0)
  vat_amount        Float     @default(0)
  description       String
  amount            Float     @default(0)
  total             Float     @default(0)
  created_at        DateTime  @default(now())

  @@map("cxp_cuedoc")
  @@index([tenant_id, cabdoc_id])
  @@index([tenant_id, account_code])
  @@index([tenant_id, branch_code, cost_center_code])
}

model PurchaseOrderInvoiceLine {
  id                     Int      @id @default(autoincrement())
  tenant_id              String
  purchase_order_id      Int
  purchase_order_line_id Int
  cxp_cabdoc_id          Int
  item_id                Int
  document_kind          String
  qty                    Float
  unit_cost              Float
  amount                 Float
  created_by             Int?
  created_at             DateTime @default(now())

  @@map("pur_order_invoice_lines")
  @@index([tenant_id, purchase_order_id])
  @@index([tenant_id, purchase_order_line_id])
  @@index([tenant_id, cxp_cabdoc_id])
}

model Employee {
  id            Int       @id @default(autoincrement())
  tenant_id     String
  user_id       Int?      @unique
  user          User?     @relation(fields: [user_id], references: [id])
  party_id      Int?
  code          String?
  user_type     String    @default("operario")
  position      String
  department    String
  salary_base   Float
  salary_type   String    @default("monthly")
  hire_date     DateTime
  end_date      DateTime?
  contract_type String    @default("indefinite")
  active        Boolean   @default(true)
  metadata      Json      @default("{}")
  payrolls      Payroll[]
  okrs          OKR[]
  time_punches  TimePunch[]
  workdays      ProcessedWorkday[]
  authorized_vehicles Vehicle[]
  preop_checklists RoutePreoperationalChecklist[]

  @@unique([tenant_id, code])
  @@index([tenant_id, active])
  @@index([tenant_id, user_type])
  @@index([tenant_id, active, user_type])
}

model Project {
  id             Int       @id @default(autoincrement())
  tenant_id      String
  code           String
  name           String
  objective      String
  status         String    @default("pendiente")
  priority       String    @default("media")
  owner_id       Int?
  owner_name     String?
  start_date     DateTime?
  target_date    DateTime?
  closed_at      DateTime?
  apex_score     Int       @default(0)
  score_status   String    @default("estable")
  progress       Int       @default(0)
  validated_progress Int   @default(0)
  metadata       Json      @default("{}")
  created_by     Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  commitments    ProjectCommitment[]
  deliverables   ProjectDeliverable[]
  risks          ProjectRisk[]
  resources      ProjectResourceAssignment[]
  comments       ProjectComment[]
  evidence       ProjectEvidence[]
  alerts         ProjectAlert[]
  logs           ProjectLog[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status])
  @@index([tenant_id, priority])
  @@index([tenant_id, target_date])
}

model ProjectCommitment {
  id             Int       @id @default(autoincrement())
  tenant_id      String
  project_id     Int
  project        Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  title          String
  description    String?
  responsible_id Int?
  responsible_name String?
  priority       String    @default("media")
  target_date    DateTime?
  status         String    @default("pendiente")
  validated_at   DateTime?
  closed_at      DateTime?
  metadata       Json      @default("{}")
  created_by     Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([tenant_id, project_id])
  @@index([tenant_id, status, target_date])
  @@index([tenant_id, responsible_id])
}

model ProjectDeliverable {
  id             Int       @id @default(autoincrement())
  tenant_id      String
  project_id     Int
  project        Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  commitment_id  Int?
  name           String
  description    String?
  responsible_id Int?
  responsible_name String?
  target_date    DateTime?
  status         String    @default("pendiente")
  validation     String?
  validated_at   DateTime?
  evidence_status String   @default("pendiente")
  metadata       Json      @default("{}")
  created_by     Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([tenant_id, project_id])
  @@index([tenant_id, status, target_date])
  @@index([tenant_id, commitment_id])
}

model ProjectRisk {
  id             Int       @id @default(autoincrement())
  tenant_id      String
  project_id     Int
  project        Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  commitment_id  Int?
  kind           String    @default("riesgo")
  description    String
  impact         String    @default("medio")
  priority       String    @default("media")
  responsible_id Int?
  responsible_name String?
  detected_at    DateTime  @default(now())
