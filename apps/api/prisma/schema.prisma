model EInvoice {
  id               Int         @id @default(autoincrement())
  tenant_id        String
  transaction_id   Int         @unique
  transaction      Transaction @relation(fields: [transaction_id], references: [id])
  country          String
  type             String
  prefix           String?
  number           Int
  full_number      String
  cufe             String?     @unique
  qr_code          String?
  uuid             String?     @unique
  sat_seal         String?
  cdr_content      String?
  status           String      @default("pending")
  rejection_reason String?
  xml_url          String?
  pdf_url          String?
  signed_at        DateTime?
  sent_at          DateTime?
  accepted_at      DateTime?
