# Variables de APEX Control Tower.
# Copia este archivo como .env.local y completa solo lo que necesites.
# .env.local esta ignorado por git. Nunca pegues tokens en issues, briefs ni commits.

# Servidor local
TOWER_HOST=127.0.0.1
TOWER_PORT=4310
TOWER_POLL_MS=10000
# Token opcional para mutaciones del panel. Si defines uno, abre el panel con ?token=...
TOWER_UI_TOKEN=
# 1 solo para certificaciones o ensayos con interrupciones simuladas.
TOWER_SIMULATION=0
# Deja vacios para usar la raiz del repositorio y apps/control-tower/data.
REPO_ROOT=
TOWER_DATA_DIR=

# API y web de APEXOS (ambiente local)
API_BASE_URL=http://127.0.0.1:3000
WEB_BASE_URL=http://127.0.0.1:3001
# Token interno para leer /api/v1/apex-control/status (opcional).
APEX_CONTROL_TOKEN=

# Ambientes vigilados
# local = rama desarrollo; develop = QA; main = produccion.
# Las URLs publicas de QA y PROD tienen valores por defecto en lib/config.js.
ENV_LOCAL_ENABLED=1
ENV_LOCAL_API_URL=http://127.0.0.1:3000
ENV_LOCAL_WEB_URL=http://127.0.0.1:3001
ENV_LOCAL_SUPABASE_URL=
ENV_LOCAL_SUPABASE_ANON_KEY=
ENV_LOCAL_RAILWAY_PROJECT_ID=
ENV_LOCAL_VERCEL_PROJECT_ID=
ENV_LOCAL_SUPABASE_REF=

ENV_DEVELOP_ENABLED=1
ENV_DEVELOP_API_URL=https://apexos-api-qa-production.up.railway.app
ENV_DEVELOP_WEB_URL=https://apexos-web-qa-production.up.railway.app
ENV_DEVELOP_SUPABASE_URL=https://jbirkghkekuifgfsgquq.supabase.co
# Llave publica anon del proyecto QA. Solo aqui; nunca en el repositorio.
ENV_DEVELOP_SUPABASE_ANON_KEY=
ENV_DEVELOP_RAILWAY_PROJECT_ID=
ENV_DEVELOP_VERCEL_PROJECT_ID=
ENV_DEVELOP_SUPABASE_REF=jbirkghkekuifgfsgquq

ENV_MAIN_ENABLED=1
ENV_MAIN_API_URL=https://apexos-api-prod-production.up.railway.app
ENV_MAIN_WEB_URL=https://apexos-web-prod-production.up.railway.app
ENV_MAIN_SUPABASE_URL=https://jzbwzmkidfthknsohhnr.supabase.co
# Llave publica anon del proyecto PROD. Solo aqui; nunca en el repositorio.
ENV_MAIN_SUPABASE_ANON_KEY=
ENV_MAIN_RAILWAY_PROJECT_ID=
ENV_MAIN_VERCEL_PROJECT_ID=
ENV_MAIN_SUPABASE_REF=jzbwzmkidfthknsohhnr

# Timeout de sondas remotas por ambiente.
ENV_TIMEOUT_MS=6000

# Nube: solo lectura. Sin tokens, la torre muestra que falta configuracion.
RAILWAY_TOKEN=
RAILWAY_API_URL=https://backboard.railway.app/graphql/v2
VERCEL_TOKEN=
# Opcional si el proyecto pertenece a un equipo.
VERCEL_TEAM_ID=
VERCEL_API_URL=https://api.vercel.com
SUPABASE_ACCESS_TOKEN=
SUPABASE_MANAGEMENT_API_URL=https://api.supabase.com
CLOUD_TIMEOUT_MS=8000
CLOUD_CACHE_MS=60000

# Git
TOWER_REMOTE=origin
TOWER_BRANCHES=desarrollo,develop,main
TOWER_GIT_REMOTE=1
TOWER_GIT_TIMEOUT_MS=8000
TOWER_GIT_FETCH_TIMEOUT_MS=60000
TOWER_GIT_REMOTE_CACHE_MS=60000

# Infraestructura local
TOWER_INFRA_TIMEOUT_MS=2500
PG_HOST=127.0.0.1
PG_PORT=55432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BRAIN_URL=http://127.0.0.1:8000
MINIO_URL=http://127.0.0.1:9000
TOWER_DOCKER=1

# Telegram
# 1. Crea un bot con BotFather y guarda el token solo aqui.
# 2. Inicia la torre y usa el codigo de emparejamiento del panel o de la consola.
# 3. Envia /pair <codigo> al bot desde tu chat.
TELEGRAM_BOT_TOKEN=
# auto | polling | dry-run | off
TELEGRAM_MODE=auto
# Lista opcional de chat ids autorizados separados por coma.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_S=25
TELEGRAM_RATE_LIMIT_PER_MIN=20
TELEGRAM_PAIRING_TTL_MS=600000

# Puente de Qoder
# Lo usa la sesion de Qoder para reclamar y reportar trabajos. No se imprime en el panel.
BRIDGE_TOKEN=
BRIDGE_OFFLINE_MS=30000

# Alertas
TOWER_ALERT_COOLDOWN_MS=300000
TOWER_ALERT_MAX=80

# Ruta de Chrome para la certificacion local (opcional).
CHROME_PATH=
