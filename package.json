{
  "name": "apex-os",
  "version": "2.0.0",
  "private": true,
  "description": "APEX OS 2.0 - El Sistema Operativo para Empresas",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis minio brain",
    "infra:up:full": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "doctor:node": "node scripts/doctor-node.js",
    "check:local": "node scripts/preflight-local.js",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "db:push": "npx prisma db push --schema apps/api/prisma/schema.prisma --skip-generate",
    "seed:demo": "node scripts/seed-admin.js",
    "seed:ops": "node scripts/seed-scj-puebla-ops.js",
    "seed:supabase:ops": "node scripts/seed-supabase-ops.js",
    "seed:supabase:active-demo": "node scripts/seed-supabase-active-demo.js",
    "seed:production:initial": "node scripts/seed-production-initial.js",
    "seed:service-references": "node scripts/import-service-references.js",
    "seed:service-technicians": "node scripts/ensure-default-service-technicians.js",
    "platform:init": "node scripts/platform-initialize.js",
    "platform:init:prod": "node scripts/platform-initialize.js --env-file config/production.env",
    "platform:init:qa": "node scripts/platform-initialize.js --env-file config/qa.env",
    "env:doctor:local": "node scripts/env-doctor.js --env local",
    "env:doctor:qa": "node scripts/env-doctor.js --env qa",
    "env:doctor:prod": "node scripts/env-doctor.js --env prod",
    "release:check:qa": "npm run env:doctor:qa && npm run prisma:validate && npm run performance:guard && node scripts/performance/validate-service-evidence-uniqueness.js --env-file=config/qa.env",
    "release:check:prod": "npm run env:doctor:prod && npm run prisma:validate && npm run performance:guard && node scripts/performance/validate-service-evidence-uniqueness.js --env-file=config/production.env",
    "validate:production:structure": "node scripts/validate-production-structure.js",
    "setup:local": "npm install && npm run check:local && npm run infra:up && npm run prisma:generate && npm run db:push && npm run seed:demo",
    "start:local": "npm run check:local && npm run infra:up && npm run dev",
    "start:desarrollo:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-apexos-desarrollo.ps1",
    "start:local:windows": "node scripts/start-local-windows.js",
    "restart:local:windows": "node scripts/start-local-windows.js --restart",
    "verify:web-assets": "node scripts/ensure-web-css.js --url http://localhost:3001/dashboard",
    "verify:web-assets:dev": "set NEXT_DIST_DIR=.next-dev&& node scripts/ensure-web-css.js --url http://localhost:3001/dashboard",
    "qa:full-validation": "node scripts/qa-full-system-validation.js",
    "qa:users:audit": "node scripts/audit-user-profiles.js",
    "qa:users:functional": "node scripts/qa-user-creation-functional.js",
    "qa:deterministic-validation": "node scripts/qa-deterministic-validation.js",
    "qa:approval:evidence": "node scripts/validate-change-approval-evidence.js",
    "certify:auth-session": "node scripts/certifications/auth-session-readiness.js",
    "certify:service-order-edit:qa": "node scripts/certifications/service-order-edit-qa.js",
    "certify:platform-regression:qa": "node scripts/certifications/platform-regression-qa.js",
    "qa:hr-services-stress": "node scripts/qa-hr-services-linear-stress.js",
    "qa:performance": "node scripts/performance/qa-latency-benchmark.js",
    "qa:root-cause": "node scripts/performance/qa-root-cause-benchmark.js",
    "qa:services-performance": "node scripts/performance/services-execution-smoke.js",
    "qa:request-map": "node scripts/performance/frontend-request-inventory.js",
    "performance:guard": "node scripts/performance/performance-budget-check.js",
    "performance:validate-evidence": "node scripts/performance/validate-service-evidence-uniqueness.js",
    "security:inspect-rls": "node scripts/security/inspect-rls-deployment.js",
    "governance:status": "node scripts/git-governance-guard.js status",
    "governance:guard": "node scripts/git-governance-guard.js implementation",
    "governance:ci": "node scripts/git-governance-guard.js ci",
    "governance:no-aux": "node scripts/git-governance-guard.js no-auxiliary-branches",
    "test:performance": "node --test apps/api/test/performance-context.test.js apps/api/test/transversal-operations.test.js",
    "test:service-corrections": "node --test apps/api/test/service-order-administrative-corrections.test.js",
    "certify:service-corrections:local": "node scripts/certify-service-order-corrections-local.js",
    "certify:service-order-items:local": "node scripts/certify-service-order-items-local.js",
    "qa:migrate-service-evidence-storage": "node scripts/migrate-qa-service-evidence-storage.js",
    "qa:validate-service-storage": "node scripts/validate-qa-service-storage.js",
    "workflow:status": "node scripts/branch-workflow.js status",
    "workflow:sync-desarrollo": "node scripts/branch-workflow.js sync-desarrollo",
    "workflow:promote-develop": "node scripts/branch-workflow.js promote-develop",
    "workflow:promote-main": "node scripts/branch-workflow.js promote-main",
    "lint": "npm --workspace apps/web run lint",
    "prisma:validate": "npx prisma validate --schema apps/api/prisma/schema.prisma",
    "brain:dev": "cd services/brain && uvicorn main:app --reload --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "overrides": {
    "brace-expansion@1.1.14": "1.1.16",
    "brace-expansion@5.0.6": "5.0.8",
    "postcss": "8.5.23"
  }
}
