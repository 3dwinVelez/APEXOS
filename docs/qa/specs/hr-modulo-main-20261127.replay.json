    {
      "file": "apps/api/prisma/schema.prisma",
      "add_lines": [
        "// Maestro de celulares compartidos para marcar jornada (M-17).",
        "// Un camion tiene UN celular y lo usan conductor y auxiliar. El celular se registra",
        "// con una llave de acceso WebAuthn (huella del telefono): la firma prueba que la",
        "// marcacion salio de ESE celular autorizado; la selfie de cada marcacion prueba",
        "// QUIEN marco, porque el lector del telefono acepta cualquier huella inscrita.",
        "// Pueden marcar en el celular los empleados con malla de HOY en la misma placa.",
        "model HrSharedDevice {",
        "id            Int       @id @default(autoincrement())",
        "tenant_id     String",
        "device_id     String",
        "credential_id String",
        "public_key    String",
        "key_algorithm String    @default(\"WEBAUTHN_ES256\")",
        "sign_count    Int       @default(0)",
        "rp_id         String",
        "vehicle_plate String",
        "label         String?",
        "device_model  String?",
        "active        Boolean   @default(true)",
        "enrolled_by   Int?",
        "enrolled_at   DateTime  @default(now())",
        "revoked_by    Int?",
        "revoked_at    DateTime?",
        "revoke_reason String?",
        "last_used_at  DateTime?",
        "created_at    DateTime  @default(now())",
        "updated_at    DateTime  @updatedAt",
        "@@map(\"hr_shared_devices\")",
        "@@unique([tenant_id, device_id])",
        "@@unique([tenant_id, credential_id])",
        "@@index([tenant_id, vehicle_plate, active])",
        "}",
        "// Maestro de rostros para marcar jornada (M-17).",
        "// Varios empleados marcan en el MISMO celular y el lector de huella del telefono no",
        "// dice de quien es la huella. Cada empleado registra su rostro (con autorizacion de",
        "// datos biometricos, Ley 1581) y cada selfie de marcacion se compara con el.",
        "// embedding: vector del modelo (model); reference_photo: la foto del registro.",
        "// Un registro activo por empleado: cambiarlo exige restablecimiento de un administrador.",
        "model HrFaceEnrollment {",
        "id                  Int       @id @default(autoincrement())",
        "tenant_id           String",
        "employee_id         Int",
        "user_id             Int?",
        "embedding           Json",
        "model               String",
        "reference_photo     Json",
        "consent_version     String",
        "consent_text_sha256 String",
        "consent_at          DateTime",
        "active              Boolean   @default(true)",
        "enrolled_by         Int?",
        "enrolled_at         DateTime  @default(now())",
        "revoked_by          Int?",
        "revoked_at          DateTime?",
        "revoke_reason       String?",
        "created_at          DateTime  @default(now())",
        "updated_at          DateTime  @updatedAt",
        "@@map(\"hr_face_enrollments\")",
        "@@index([tenant_id, employee_id, active])",
        "@@index([tenant_id, active])",
        "}",
        "// Huella propia de cada empleado para marcar desde el navegador (WebAuthn, M-17).",
        "// Cada empleado registra con su usuario una llave de acceso en el celular (varios",
        "// empleados pueden registrar la suya en el mismo celular). Cada marcacion va firmada",
        "// con esa llave tras la huella; el rostro (HrFaceEnrollment) prueba quien marco.",
        "model HrWebauthnCredential {",
        "id            Int       @id @default(autoincrement())",
        "tenant_id     String",
        "employee_id   Int",
        "user_id       Int",
        "credential_id String",
        "public_key    String",
        "key_algorithm String    @default(\"WEBAUTHN_ES256\")",
        "sign_count    Int       @default(0)",
        "rp_id         String",
        "device_label  String?",
        "active        Boolean   @default(true)",
        "enrolled_at   DateTime  @default(now())",
        "last_used_at  DateTime?",
        "revoked_by    Int?",
        "revoked_at    DateTime?",
        "revoke_reason String?",
        "created_at    DateTime  @default(now())",
        "updated_at    DateTime  @updatedAt",
        "@@map(\"hr_webauthn_credentials\")",
        "@@unique([tenant_id, credential_id])",
        "@@index([tenant_id, employee_id, active])",
        "}"
      ],
      "nota": "94 lineas fisicas de desarrollo, 82 no vacias; el resto son blancos"
    },
