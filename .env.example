NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
DATABASE_URL=postgresql://apex:apex_dev_password@localhost:55432/apexos
# QA/production must use the hosted Postgres URL for the target Supabase project.
# Do not point Railway QA or migration jobs to localhost.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379
# Set true/1 in QA environments without Redis. Queues and workers become noop.
REDIS_DISABLED=false
DISABLE_REDIS=false
JWT_SECRET=change_me_with_64_random_chars
API_BODY_LIMIT_BYTES=26214400
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=10
MAX_EVIDENCE_BYTES=12582912
MAX_DOCUMENT_BYTES=20971520
BRAIN_URL=http://localhost:8000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=apex_minio
MINIO_SECRET_KEY=change_me_minio_secret
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
GRAFANA_PASS=change_me_grafana
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=20000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=45
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_TIMEOUT_MS=20000
# Server-only. Never expose this with NEXT_PUBLIC_ or use it in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Environment guidance:
# - local: local DATABASE_URL/API_URL and optional Supabase QA credentials for manual testing.
# - qa: hosted Supabase URL + publishable anon key + server-only service role key.
# - production: production Supabase project and rotated production-only secrets.
