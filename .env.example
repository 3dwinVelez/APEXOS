APP_ENV=local
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
# Optional alias used by deployment docs; API reads ALLOWED_ORIGINS.
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://apex:apex_dev_password@localhost:55432/apexos
# QA/production must use the hosted Postgres URL for the target Supabase project.
# Do not point Railway QA or migration jobs to localhost.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# If using the Supabase transaction pooler with Prisma, include pgbouncer mode:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
REDIS_URL=redis://localhost:6379
# Set true/1 in QA environments without Redis. Queues and workers become noop.
REDIS_DISABLED=false
DISABLE_REDIS=false
JWT_SECRET=change_me_with_64_random_chars
API_BODY_LIMIT_BYTES=26214400
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=10
MAX_EVIDENCE_BYTES=12582912
MAX_DOCUMENT_BYTES=20971520
BRAIN_URL=http://localhost:8000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=apex_minio
MINIO_SECRET_KEY=change_me_minio_secret
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
GRAFANA_PASS=change_me_grafana
NEXT_PUBLIC_API_URL=
PERFORMANCE_LOG_ENABLED=false
PERFORMANCE_SLOW_QUERY_MS=300
PERFORMANCE_SIMPLE_BUDGET_MS=300
PERFORMANCE_CRITICAL_MS=2000
SUPABASE_AUTH_CACHE_TTL_MS=30000
SUPABASE_AUTH_CACHE_MAX_ENTRIES=500

# Performance audit only. Keep QA credentials outside version control.
QA_WEB_URL=
QA_API_URL=
QA_SUPABASE_SCJ_EMAIL=
QA_SUPABASE_SCJ_PASSWORD=
NEXT_PUBLIC_API_TIMEOUT_MS=20000
NEXT_PUBLIC_API_GET_CACHE_TTL_MS=10000
NEXT_PUBLIC_API_GET_STALE_MS=60000
NEXT_PUBLIC_API_GET_CACHE_MAX_ENTRIES=160
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=45
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_TIMEOUT_MS=20000
NEXT_PUBLIC_SUPABASE_GET_CACHE_TTL_MS=12000
NEXT_PUBLIC_SUPABASE_GET_STALE_MS=60000
NEXT_PUBLIC_SUPABASE_GET_CACHE_MAX_ENTRIES=120
# Server-only. Never expose this with NEXT_PUBLIC_ or use it in client components.
SUPABASE_SERVICE_ROLE_KEY=
# Public service request default company. Server-side preferred; public alias kept for deployments that need it.
APEXOS_PUBLIC_SERVICE_COMPANY_ID=
NEXT_PUBLIC_APEXOS_PUBLIC_COMPANY_ID=

# Environment guidance:
# - local: local DATABASE_URL/API_URL and optional Supabase QA credentials for manual testing.
# - qa: hosted Supabase URL + publishable anon key + server-only service role key.
# - production: production Supabase project and rotated production-only secrets.
